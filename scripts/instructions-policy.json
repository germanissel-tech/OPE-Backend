{
  "coreMaxLines": 200,
  "implicitRoots": [
    "",
    "src/",
    "src/domain/",
    "src/application/",
    "src/interface-adapters/",
    "src/composition/",
    "src/infrastructure/",
    "contracts/",
    "../"
  ],
  "notPaths": {
    "shapeNames": [
      "errors.ts",
      "index.ts",
      "ids.ts",
      "presenters.ts",
      "services/",
      "ports/",
      "use-cases/",
      "controllers/"
    ],
    "namespacePrefixes": ["ope/", "#", "@"]
  },
  "commandsSection": "Comandos",
  "commandsInventory": "scripts/README.md",
  "files": [
    {
      "file": "CLAUDE.md",
      "role": "core",
      "sections": [
        {
          "heading": "OPE-Backend — instrucciones para agentes",
          "kind": "normative"
        },
        {
          "heading": "Fuentes de verdad, en este orden",
          "kind": "normative"
        },
        {
          "heading": "Flujo de trabajo (inamovible)",
          "kind": "normative"
        },
        {
          "heading": "Comandos",
          "kind": "descriptive"
        },
        {
          "heading": "Tipado (ADR-011, ADR-012, ADR-017; verificado por `lint` y `typecheck`)",
          "kind": "normative"
        },
        {
          "heading": "Documentación viva",
          "kind": "normative"
        },
        {
          "heading": "Reglas que fallan el build (no son sugerencias)",
          "kind": "normative"
        },
        {
          "heading": "Convenciones",
          "kind": "normative"
        },
        {
          "heading": "Si existe `HANDOFF.md` en la raíz",
          "kind": "normative"
        },
        {
          "heading": "Reglas acotadas",
          "kind": "normative"
        }
      ]
    },
    {
      "file": ".claude/rules/auditoria.md",
      "role": "rule",
      "paths": ["tests/audit/**", ".claude/skills/**", "scripts/audit/**", "audit.profile.json"],
      "sections": [
        {
          "heading": "Auditoría de arquitectura (ADR-032)",
          "kind": "descriptive"
        }
      ]
    },
    {
      "file": ".claude/rules/entidad.md",
      "role": "rule",
      "paths": ["src/domain/**"],
      "sections": [
        {
          "heading": "Cómo se escribe una entidad (ADR-024, verificado por `lint`)",
          "kind": "normative"
        }
      ]
    },
    {
      "file": ".claude/rules/gates-de-calidad.md",
      "role": "rule",
      "paths": ["src/**", "tests/**", "eslint.config.mjs"],
      "sections": [
        {
          "heading": "Gates de calidad (ADR-016, verificado por `quality` y `test:mutation`)",
          "kind": "normative"
        }
      ]
    },
    {
      "file": ".claude/rules/caso-de-uso.md",
      "role": "rule",
      "paths": ["src/application/**"],
      "sections": [
        {
          "heading": "Cómo se escribe un caso de uso (ADR-023, verificado por `lint` y `arch`)",
          "kind": "normative"
        }
      ]
    },
    {
      "file": ".claude/rules/anillos-y-modulos.md",
      "role": "rule",
      "paths": ["src/**"],
      "sections": [
        {
          "heading": "Anillos y módulos (ADR-013, verificado por `npm run arch`)",
          "kind": "mixed",
          "reason": "The ring table is the rule an agent obeys; the list of modules describes what exists today and `arch` already verifies it. Separating them is pending."
        }
      ]
    },
    {
      "file": ".claude/rules/contrato.md",
      "role": "rule",
      "paths": ["contracts/**"],
      "sections": [
        {
          "heading": "Notas operativas del contrato",
          "kind": "descriptive"
        },
        {
          "heading": "El orden dentro de una feature que toca HTTP",
          "kind": "normative"
        }
      ]
    }
  ],
  "exceptions": [
    {
      "cite": "origin/main",
      "reason": "A git reference, not a path of the tree."
    },
    {
      "cite": "merchantId/orderId",
      "reason": "The composite key an order is identified by; the slash joins two fields."
    },
    {
      "cite": "research.md",
      "reason": "Names the file each feature carries under its own specs/ directory, not one file."
    },
    {
      "cite": "HANDOFF.md",
      "reason": "Exists only while a task is in flight; the section that cites it explains exactly that."
    },
    {
      "script": "prepare",
      "reason": "An npm hook, not a command an agent invokes."
    },
    {
      "script": "postinstall",
      "reason": "An npm hook; it applies the patches."
    }
  ]
}
