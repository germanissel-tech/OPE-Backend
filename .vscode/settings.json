{
  // Artefactos generados: no se editan, no se buscan, no se lintean.
  // docs/api/index.html lleva Redoc inlineado (~1 MB minificado); contracts/dist es el bundle.
  "files.exclude": {
    "docs/api/": true,
    "contracts/dist/": true,
    ".schemathesis/": true
  },
  "search.exclude": {
    "docs/api/": true,
    "contracts/dist/": true,
    "src/generated/": true,
    "dist/": true,
    "node_modules/": true
  },
  "files.watcherExclude": {
    "**/docs/api/**": true,
    "**/contracts/dist/**": true,
    "**/.schemathesis/**": true
  },
  // El único HTML del repo es el generado; no hay nada fuente que validar.
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "files.eol": "\n",
  // Formato y lint en el editor con las mismas herramientas del repo.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "eslint.validate": ["javascript", "typescript"],
  "prettier.requireConfig": true,
  // ADR-017: the editor's language service is TypeScript 7 (native preview extension) when
  // available; `typescript.tsdk` stays on the 6.0 API package that the tools import, so
  // "Use Workspace Version" still resolves to a JS-based service.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.experimental.useTsgo": true
}
