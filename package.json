{
  "name": "ope-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del MVP de OPE. API-first: contracts/openapi.yaml es la fuente de verdad de toda superficie HTTP.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./client": {
      "types": "./dist/interface-adapters/http/client.d.ts",
      "default": "./dist/interface-adapters/http/client.js"
    }
  },
  "scripts": {
    "contract:lint": "node scripts/contract-lint.mjs",
    "contract:bundle": "node scripts/contract-bundle.mjs",
    "contract:diff": "node scripts/contract-diff.mjs",
    "contract:types": "node scripts/contract-types.mjs",
    "contract:types:check": "node scripts/contract-types-check.mjs",
    "check:invariant-tests": "node scripts/check-invariant-tests.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:markers": "node scripts/check-markers.mjs",
    "contract:check": "npm run contract:lint && npm run contract:bundle && npm run contract:diff && npm run contract:types:check && npm run check:invariant-tests && npm run check:glossary && npm run check:adrs && npm run check:markers",
    "release-check": "node scripts/release-check.mjs",
    "contract:mock": "cross-env OPE_MOCK=1 tsx src/main.ts",
    "contract:docs": "node scripts/contract-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-lint-exceptions.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.scripts.json",
    "arch": "node node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config .dependency-cruiser.cjs src",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:contract": "npm run contract:bundle && node scripts/test-contract.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "openapi-backend": "^5.20.3",
    "openapi-fetch": "^0.17.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.53.2",
    "@stoplight/spectral-cli": "^6.16.3",
    "@stoplight/spectral-core": "^1.23.1",
    "@stoplight/spectral-ruleset-bundler": "^1.7.0",
    "@types/node": "^22.20.3",
    "cross-env": "^10.0.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "openapi-typescript": "^7.13.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.7",
    "redoc": "^2.5.4",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
