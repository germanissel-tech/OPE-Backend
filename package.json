{
  "name": "ope-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OPE MVP backend. API-first: contracts/openapi.yaml is the source of truth for every HTTP surface.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "imports": {
    "#generated/*": "./generated/*"
  },
  "scripts": {
    "contract:lint": "node scripts/contract-lint.mjs",
    "contract:bundle": "node scripts/contract-bundle.mjs",
    "contract:diff": "node scripts/contract-diff.mjs",
    "contract:types": "node scripts/contract-types.mjs",
    "contract:types:check": "node scripts/contract-types-check.mjs",
    "check:invariant-tests": "node scripts/check-invariant-tests.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check:identifiers": "node scripts/check-identifiers.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:markers": "node scripts/check-markers.mjs",
    "contract:check": "npm run contract:lint && npm run contract:bundle && npm run contract:diff && npm run contract:types:check && npm run check:invariant-tests && npm run check:glossary && npm run check:identifiers && npm run check:adrs && npm run check:markers && npm run check:language && npm run check:api-map",
    "release-check": "node scripts/release-check.mjs",
    "contract:docs": "node scripts/contract-docs.mjs",
    "contract:insomnia": "node scripts/contract-insomnia.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-lint-exceptions.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.scripts.json",
    "arch": "node node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config .dependency-cruiser.cjs src",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "dev": "cross-env OPE_MERCHANTS_FILE=config/dev-merchants.json OPE_ADMIN_OPERATORS_FILE=config/dev-operators.json tsx watch src/main.ts",
    "test": "vitest run --project fast",
    "test:tools": "vitest run --project tools",
    "test:all": "vitest run",
    "test:scoped": "node scripts/test-scope.mjs",
    "test:contract": "npm run contract:bundle && node scripts/test-contract.mjs",
    "check:api-map": "node scripts/check-api-map.mjs",
    "check:language": "node scripts/check-language.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:behaviour-constants": "node scripts/check-behaviour-constants.mjs",
    "check:ports-bound": "node scripts/check-ports-bound.mjs",
    "quality": "node scripts/quality.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:mutation": "node scripts/mutation-diff.mjs",
    "check:mutation-report": "node scripts/mutation-diff.mjs --check-report",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "openapi-backend": "^5.20.3",
    "openapi-fetch": "^0.17.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.53.2",
    "@stoplight/spectral-cli": "^6.16.3",
    "@stoplight/spectral-core": "^1.23.1",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-ruleset-bundler": "^1.7.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "lefthook": "^2.1.14",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "pino": "^10.3.1",
    "prettier": "^3.9.7",
    "redoc": "^2.5.4",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
