{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditable-architecture:finding",
  "title": "AuditFinding",
  "description": "A design-review finding proposed by the auditing-architecture skill. verify-finding.mjs judges each one by this shape, then checks that file:line exists, that rule.source starts with a kind the profile (audit.profile.json) declares and resolves by that kind, and that the severity is the one the kind imposes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "file", "line", "rule", "severity", "evidence", "proposal", "coveringTest", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F-[0-9]{3}$"
    },
    "file": {
      "type": "string",
      "description": "Repo-relative path with forward slashes.",
      "pattern": "^[^\\\\]+$"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Short slug, e.g. srp-one-authority-per-module."
        },
        "source": {
          "type": "string",
          "description": "Where the rule is written down: `<kind><rest>`, where <kind> is a prefix the profile declares (for example `ADR-`, `constitution#`, `lint:`) and <rest> is what its resolver looks up."
        }
      }
    },
    "severity": {
      "enum": ["high", "medium", "low"],
      "description": "Imposed by the kind of rule.source (profile.sources[].severity), never chosen by the reviewer."
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "coveringTest": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["proposed", "confirmed", "refuted"]
    },
    "refutation": {
      "type": "string",
      "description": "Required when status is refuted."
    },
    "closure": {
      "type": "object",
      "description": "How a later feature closed the finding (optional; verify-finding.mjs does not judge it).",
      "additionalProperties": false,
      "required": ["status", "by", "feature"],
      "properties": {
        "status": {
          "enum": ["resolved", "absorbed-by", "rejected"]
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "Commit hash, F-NNN or the owner's reason."
        },
        "feature": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        }
      }
    },
    "verified": {
      "type": "boolean",
      "description": "Set by verify-finding.mjs."
    },
    "reason": {
      "type": "string",
      "description": "Set by verify-finding.mjs when verified is false."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "refuted"
          }
        }
      },
      "then": {
        "required": ["refutation"]
      }
    }
  ]
}
