{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "client/index.ts",
    "scripts/*.mjs",
    "contracts/rules/functions/*.js",
    "tests/**/*.test.ts",
    "tests/**/*.test-d.ts",
    "tests/contract-rules/gen-fixtures.mjs",
    "tests/contract/fixtures/health-203.ts",
    "eslint.config.mjs",
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    ".dependency-cruiser.cjs",
    "plugins/*/skills/*/scripts/*.mjs",
    "scripts/audit/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "client/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "contracts/rules/functions/*.js",
    "plugins/**/*.mjs"
  ],
  "ignore": [
    "tests/**/fixtures/**",
    "generated/**",
    "tests/lint/fixtures/**",
    "plugins/**/evals/**",
    "tests/audit/evals/**"
  ],
  "ignoreDependencies": [
    "@redocly/cli",
    "@stoplight/spectral-ruleset-bundler",
    "redoc",
    "jscpd",
    "@stryker-mutator/core",
    "@stryker-mutator/typescript-checker",
    "@stryker-mutator/vitest-runner"
  ],
  "ignoreBinaries": ["uvx"]
}
