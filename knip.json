{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/interface-adapters/http/client.ts",
    "scripts/*.mjs",
    "contracts/rules/functions/*.js",
    "tests/**/*.test.ts",
    "tests/**/*.test-d.ts",
    "tests/contract-rules/gen-fixtures.mjs",
    "tests/contract/fixtures/health-203.ts",
    "eslint.config.mjs",
    "vitest.config.ts",
    ".dependency-cruiser.cjs",
    ".claude/skills/*/scripts/*.mjs"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts", "contracts/rules/functions/*.js"],
  "ignore": [
    "tests/**/fixtures/**",
    "src/interface-adapters/http/generated/**",
    ".claude/skills/*/evals/**",
    "tests/lint/fixtures/**"
  ],
  "ignoreDependencies": [
    "@redocly/cli",
    "@stoplight/spectral-ruleset-bundler",
    "redoc",
    "jscpd",
    "@stryker-mutator/core",
    "@stryker-mutator/typescript-checker",
    "@stryker-mutator/vitest-runner"
  ],
  "ignoreBinaries": ["uvx"]
}
