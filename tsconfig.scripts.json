{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.mjs",
    "contracts/rules/functions/*.js",
    "tests/contract-rules/gen-fixtures.mjs",
    ".dependency-cruiser.cjs"
  ]
}
